{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mockmate.local/schema/question.json",
  "title": "Bagu Interview Simulator bank question",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "topics",
    "role",
    "level",
    "difficulty",
    "type",
    "answer",
    "source",
    "status",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "title": { "type": "string", "minLength": 1 },
    "body": { "type": "string" },
    "topics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "role": { "type": "string", "minLength": 1 },
    "level": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 5 },
        { "enum": ["junior", "mid", "senior", "staff"] }
      ]
    },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "type": {
      "enum": ["knowledge", "behavioral", "system-design", "coding", "project"]
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "keyPoints"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "keyPoints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "pitfalls": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "followups": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "title", "license"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "title": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "retrievedAt": { "type": "string", "format": "date" }
      }
    },
    "status": {
      "enum": ["verified", "community", "ai-draft", "user", "orphaned"]
    },
    "updatedAt": { "type": "string", "format": "date" }
  }
}
